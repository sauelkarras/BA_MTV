cabal-version:      1.24
name:               dq-checkers
version:            0.1.0.0
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:  Extract, Checker, CoqBridge
  other-modules:    BinInt, BinNums, BinPos, Datatypes, List
  build-depends:    base >=4.14 && <5, bytestring, text, vector, cassava
  default-language: Haskell2010

executable dq-check
  hs-source-dirs:   app, src
  main-is:          Main.hs
  build-depends:    base, dq-checkers, bytestring, text, vector, cassava
  default-language: Haskell2010
